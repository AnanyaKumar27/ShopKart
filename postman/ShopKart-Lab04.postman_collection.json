              "pm.test('Customer registration returns 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Registration succeeds and does not return a password', function () { pm.expect(body.success).to.eql(true); pm.expect(body.customer).to.have.property('_id'); pm.expect(body.customer).not.to.have.property('password'); });",
