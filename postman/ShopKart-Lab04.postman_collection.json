    {
      "name": "ShopKart — Lab 06 Checkout & Orders API Checks",
      "description": "Run requests sequentially. Creates temporary users, product, pending ShopKart order and Razorpay Test Mode order. Optional stock check: add the product to cart, lower its stock below the cart quantity in MongoDB, set lab06RunStockTest=true, and run request 5a; expect 400, then restore stock and set the variable back to false. Request 21 is optional and requires a real Razorpay Test Mode checkout. To check cancellation, close Razorpay Checkout and run requests 10–11; the order should remain pending and the cart unchanged.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('lab06TestEmail')) pm.collectionVariables.set('lab06TestEmail', 'lab06.postman.' + Date.now() + '@example.test');",
              "if (!pm.collectionVariables.get('lab06OtherEmail')) pm.collectionVariables.set('lab06OtherEmail', 'lab06.other.' + Date.now() + '@example.test');",
              "if (!pm.collectionVariables.get('lab06ProductName')) pm.collectionVariables.set('lab06ProductName', 'Lab06 Checkout Temp ' + Date.now());"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "0. Register temporary Lab 06 customer",
          "description": "Creates a fresh test account for each complete folder run.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Lab 06 Postman Verification\",\n  \"email\": \"{{lab06TestEmail}}\",\n  \"password\": \"{{lab06TestPassword}}\",\n  \"phone\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/customers/register"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now();",
                  "pm.collectionVariables.set('lab06TestEmail', 'lab06.postman.' + runId + '@example.test');",
                  "pm.collectionVariables.set('lab06OtherEmail', 'lab06.other.' + runId + '@example.test');",
                  "pm.collectionVariables.set('lab06ProductName', 'Lab06 Checkout Temp ' + runId);",
                  "pm.collectionVariables.set('lab06RazorpayPaymentId', '');",
                  "pm.collectionVariables.set('lab06RazorpaySignature', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 201 and omits password', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().customer).not.to.have.property('password'); });"
                ]
              }
            }
          ]
        },
