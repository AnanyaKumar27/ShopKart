        {
          "name": "21. Verify successful Razorpay Test Mode payment (manual)",
          "description": "Optional: complete a successful Razorpay Test Mode checkout in the frontend as this Lab 06 customer. In DevTools > Network, copy shopKartOrderId, razorpay_order_id, razorpay_payment_id and razorpay_signature from the successful POST /orders/verify-payment payload into the matching lab06 collection variables, then run this idempotent confirmation. Never store the Razorpay secret in Postman.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopKartOrderId\": \"{{lab06ShopKartOrderId}}\",\n  \"razorpay_order_id\": \"{{lab06RazorpayOrderId}}\",\n  \"razorpay_payment_id\": \"{{lab06RazorpayPaymentId}}\",\n  \"razorpay_signature\": \"{{lab06RazorpaySignature}}\"\n}",
